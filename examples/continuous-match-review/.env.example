# Aidbox
AIDBOX_URL=http://localhost:8888
# root:root from the shared examples/docker-compose.yaml stack.
AIDBOX_AUTH=Basic cm9vdDpyb290

# MDMbox
MDMBOX_URL=http://localhost:3003
# Authorization header added by the dev proxy on every MDMbox request.
# Leave unset when MDMbox runs with auth disabled (MDMBOX_AUTH_ENABLED=false).
# MDMBOX_AUTH=Basic cm9vdDpyb290
