  "abstract": false,
  "type": "Linkage",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Linkage",
  "derivation": "constraint",
  "description": "Example-owned grouping of source Conditions by code and onset inside one Patient cluster.",
  "differential": {
    "element": [
      {"id": "Linkage", "path": "Linkage"},
      {"id": "Linkage.active", "path": "Linkage.active", "min": 1, "fixedBoolean": true},
