      {"id": "Linkage.item", "path": "Linkage.item", "min": 2, "slicing": {"discriminator": [{"type": "value", "path": "type"}], "rules": "closed"}},
      {"id": "Linkage.item:source", "path": "Linkage.item", "sliceName": "source", "min": 1, "max": "1"},
      {"id": "Linkage.item:source.type", "path": "Linkage.item.type", "fixedCode": "source"},
      {"id": "Linkage.item:source.resource", "path": "Linkage.item.resource", "type": [{"code": "Reference", "targetProfile": ["http://hl7.org/fhir/StructureDefinition/Condition"]}]},
      {"id": "Linkage.item:alternate", "path": "Linkage.item", "sliceName": "alternate", "min": 1},
      {"id": "Linkage.item:alternate.type", "path": "Linkage.item.type", "fixedCode": "alternate"},
      {"id": "Linkage.item:alternate.resource", "path": "Linkage.item.resource", "type": [{"code": "Reference", "targetProfile": ["http://hl7.org/fhir/StructureDefinition/Condition"]}]}
    ]
  }
