# Copy to .env. Never commit the real JWT values.
AIDBOX_LICENSE=
MDMBOX_LICENSE=
INTERBOX_LICENSE=

# Pinned runtime images. Override only when deliberately testing an upgrade.
MDMBOX_IMAGE=healthsamurai/mdmbox:2608.0
AIDBOX_IMAGE=healthsamurai/aidboxone:2608.4
# Official main build with concurrent sender writeback recovery; digest pins both platforms.
INTERBOX_IMAGE=healthsamurai/interbox:main-d39e2f23a90c@sha256:81926d8f9608a0bc440295f7f211a77c17b85aca1ee5e23d52c80db50b5a91e0
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
GRAFANA_IMAGE=grafana/grafana:12.4.1

# Local example credential shared by the stock sender and the MDM adapter.
MDM_ADAPTER_TOKEN=showcase-adapter
